              "$ref": "#/$defs/Uuid"
            },
            "kind": {
              "const": "item_center",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "item"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "datum": {
              "$ref": "#/$defs/Uuid"
            },
            "kind": {
              "const": "datum",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "datum"
          ],
          "type": "object"
        }
      ]
    },
    "SetConstraintValue": {
      "additionalProperties": false,
      "description": "Sets one dimension (8.2). Moves resolve to these.",
      "properties": {
        "target": {
          "$ref": "#/$defs/DimensionTarget"
        },
        "value": {
          "$ref": "#/$defs/Length"
        }
      },
      "required": [
        "target",
        "value"
      ],
      "type": "object"
    },
    "SetProjectUnits": {
      "additionalProperties": false,
      "description": "Sets the unit of bare numbers.",
      "properties": {
        "default_unit": {
          "$ref": "#/$defs/ProjectUnit"
        }
      },
      "required": [
        "default_unit"
      ],
      "type": "object"
    },
    "SetStorey": {
      "additionalProperties": false,
      "description": "Creates a storey (`storey` is null) or replaces an existing one.",
      "properties": {
        "default_ceiling_height": {
          "$ref": "#/$defs/Sourced"
        },
        "elevation": {
          "$ref": "#/$defs/Sourced"
        },
        "floor_to_floor": {
          "$ref": "#/$defs/Sourced"
        },
        "name": {
          "type": "string"
        },
        "storey": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "elevation",
        "floor_to_floor",
        "default_ceiling_height"
      ],
      "type": "object"
    },
    "SetVariantSelection": {
      "additionalProperties": false,
      "description": "Selects one of a variant slot's options.",
      "properties": {
        "selected": {
          "$ref": "#/$defs/Uuid"
        },
        "slot": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "slot",
        "selected"
      ],
      "type": "object"
    },
    "SetWallLayers": {
      "additionalProperties": false,
      "description": "Gives a wall exactly these layers and left extent (Q-43). A layer set\nshared with other walls is copied, so they are untouched.",
      "properties": {
        "layers": {
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "type": "array"
        },
        "left_extent": {
          "$ref": "#/$defs/Sourced"
        },
        "wall": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "wall",
        "layers",
        "left_extent"
      ],
      "type": "object"
    },
    "Source": {
      "description": "Where a value came from (spec 7.2).",
      "enum": [
        "user_stated",
        "measured",
        "derived",
        "proposed",
        "imported"
      ],
      "type": "string"
    },
    "Sourced": {
      "additionalProperties": false,
      "description": "A value together with its source (Q-4).",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "$ref": "#/$defs/Length"
        }
      },
      "required": [
        "value",
        "source"
      ],
      "type": "object"
    },
    "Uuid": {
      "description": "An entity identifier. Serialized as a lowercase hyphenated string.",
      "format": "uuid",
      "type": "string"
    },
    "WallSide": {
      "description": "A side of a wall, looking from node_a to node_b (6.1).",
      "enum": [
        "left",
        "right"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`commit`: commits a proposal made earlier, if nothing changed since.",
  "properties": {
    "action": {
      "$ref": "#/$defs/ProposedAction"
    },
    "actor": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "base_version": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "proposal_id": {
      "$ref": "#/$defs/Uuid"
    },
    "timestamp_ms": {
      "default": null,
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "proposal_id",
    "base_version",
    "action"
  ],
  "title": "CommitRequest",
  "type": "object"
}
