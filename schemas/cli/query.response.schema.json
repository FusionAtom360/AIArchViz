{
  "$defs": {
    "CliError": {
      "description": "A failed request.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Stable error codes (Q-50). Never change a code's meaning once released.",
      "enum": [
        "BAD_REQUEST",
        "NOT_A_PROJECT",
        "PROJECT_EXISTS",
        "LOCKED",
        "CORRUPT_PROJECT",
        "COMMAND_FAILED",
        "STALE",
        "ALTERED",
        "BLOCKED",
        "NOTHING_TO_UNDO",
        "NOT_FOUND",
        "IO"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The response every subcommand writes.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/CliError"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "result": true
  },
  "required": [
    "ok"
  ],
  "title": "Response",
  "type": "object"
}
