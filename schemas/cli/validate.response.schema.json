{
  "$defs": {
    "CliError": {
      "description": "A failed request.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Detail": {
      "description": "What exactly is wrong.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "node_b is `length` from node_a along the wall's direction (zero or less).",
          "properties": {
            "non_positive_length": {
              "properties": {
                "length": {
                  "$ref": "#/$defs/Length"
                }
              },
              "required": [
                "length"
              ],
              "type": "object"
            }
          },
          "required": [
            "non_positive_length"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The nodes are `offset` apart across the wall's direction.",
          "properties": {
            "not_on_one_line": {
              "properties": {
                "offset": {
                  "$ref": "#/$defs/Length"
                }
              },
              "required": [
                "offset"
              ],
              "type": "object"
            }
          },
          "required": [
            "not_on_one_line"
          ],
          "type": "object"
        },
        {
          "const": "overlap",
          "description": "The two walls' footprints share area.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Every problem with one opening.",
          "properties": {
            "opening": {
              "items": {
                "$ref": "#/$defs/OpeningProblem"
              },
              "type": "array"
            }
          },
          "required": [
            "opening"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Why the outline is not a simple rectilinear polygon.",
          "properties": {
            "outline": {
              "$ref": "#/$defs/SpaceError"
            }
          },
          "required": [
            "outline"
          ],
          "type": "object"
        },
        {
          "const": "blocked",
          "description": "A clearance zone is entered by a wall or another occurrence.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Why a roof is not well defined.",
          "properties": {
            "roof": {
              "$ref": "#/$defs/RoofProblem"
            }
          },
          "required": [
            "roof"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "What is wrong with a wall that follows a roof (DEC-6).",
          "properties": {
            "wall_top": {
              "$ref": "#/$defs/WallTopProblem"
            }
          },
          "required": [
            "wall_top"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The footprints are `dx` and `dy` apart, closer than `required` (Q-32).",
          "properties": {
            "too_close": {
              "properties": {
                "dx": {
                  "$ref": "#/$defs/Length"
                },
                "dy": {
                  "$ref": "#/$defs/Length"
                },
                "required": {
                  "$ref": "#/$defs/Length"
                }
              },
              "required": [
                "dx",
                "dy",
                "required"
              ],
              "type": "object"
            }
          },
          "required": [
            "too_close"
          ],
          "type": "object"
        }
      ]
    },
    "ErrorCode": {
      "description": "Stable error codes (Q-50). Never change a code's meaning once released.",
      "enum": [
        "BAD_REQUEST",
        "NOT_A_PROJECT",
        "PROJECT_EXISTS",
        "LOCKED",
        "CORRUPT_PROJECT",
        "COMMAND_FAILED",
        "STALE",
        "ALTERED",
        "BLOCKED",
        "NOTHING_TO_UNDO",
        "NOT_FOUND",
        "IO"
      ],
      "type": "string"
    },
    "GeometryError": {
      "description": "Why wall geometry cannot be built.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "unknown_entity": {
              "properties": {
                "id": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          },
          "required": [
            "unknown_entity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The wall's nodes are not on one line in its direction, or it has no length.",
          "properties": {
            "bad_wall": {
              "properties": {
                "wall": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "wall"
              ],
              "type": "object"
            }
          },
          "required": [
            "bad_wall"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Two walls leave this node in the same direction (Q-19).",
          "properties": {
            "same_direction": {
              "properties": {
                "node": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "node"
              ],
              "type": "object"
            }
          },
          "required": [
            "same_direction"
          ],
          "type": "object"
        },
        {
          "const": "overflow",
          "description": "A coordinate is outside the Length range.",
          "type": "string"
        }
      ]
    },
    "Length": {
      "description": "A length in nanometers.",
      "format": "int64",
      "type": "integer"
    },
    "OpeningProblem": {
      "description": "What is wrong with an opening's fit in its host (7.7, Q-22).",
      "oneOf": [
        {
          "const": "non_positive_size",
          "description": "Width or height is zero or negative.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Closer than the minimum jamb distance to the start of the\nfull-thickness stretch; negative clearance means outside it.",
          "properties": {
            "too_close_to_start": {
              "properties": {
                "clearance": {
                  "$ref": "#/$defs/Length"
                }
              },
              "required": [
                "clearance"
              ],
              "type": "object"
            }
          },
          "required": [
            "too_close_to_start"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The same at the end.",
          "properties": {
            "too_close_to_end": {
              "properties": {
                "clearance": {
                  "$ref": "#/$defs/Length"
                }
              },
              "required": [
                "clearance"
              ],
              "type": "object"
            }
          },
          "required": [
            "too_close_to_end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The sill is below the wall's base by this much.",
          "properties": {
            "below_base": {
              "properties": {
                "by": {
                  "$ref": "#/$defs/Length"
                }
              },
              "required": [
                "by"
              ],
              "type": "object"
            }
          },
          "required": [
            "below_base"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The head is above the wall's top by this much; for a wall that\nfollows a roof, at or above it (DEC-6).",
          "properties": {
            "above_top": {
              "properties": {
                "by": {
                  "$ref": "#/$defs/Length"
                }
              },
              "required": [
                "by"
              ],
              "type": "object"
            }
          },
          "required": [
            "above_top"
          ],
          "type": "object"
        }
      ]
    },
    "PolygonError": {
      "description": "Why a polygon is not a simple rectilinear polygon.",
      "oneOf": [
        {
          "enum": [
            "too_few_vertices",
            "non_positive_area"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Edge `edge` (from vertex `edge` to the next) is diagonal or has no length.",
          "properties": {
            "not_rectilinear": {
              "properties": {
                "edge": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "edge"
              ],
              "type": "object"
            }
          },
          "required": [
            "not_rectilinear"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Two edges cross, touch or overlap.",
          "properties": {
            "self_intersecting": {
              "properties": {
                "first": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "second": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "first",
                "second"
              ],
              "type": "object"
            }
          },
          "required": [
            "self_intersecting"
          ],
          "type": "object"
        }
      ]
    },
    "RoofProblem": {
      "description": "Why a roof is not well defined.",
      "oneOf": [
        {
          "enum": [
            "overflow"
          ],
          "type": "string"
        },
        {
          "const": "ledger_not_existing_wall_face",
          "description": "The ledger is not a face of an existing wall (Q-45).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The footprint's outline cannot be found.",
          "properties": {
            "footprint": {
              "$ref": "#/$defs/SpaceError"
            }
          },
          "required": [
            "footprint"
          ],
          "type": "object"
        },
        {
          "const": "no_run",
          "description": "The high edge is not before the low side along the slope.",
          "type": "string"
        },
        {
          "const": "zero_pitch_run",
          "description": "A pitch with a zero run.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A stated low edge height differs from the one the pitch gives.",
          "properties": {
            "pitch_disagrees": {
              "properties": {
                "derived": {
                  "$ref": "#/$defs/Length"
                },
                "stated": {
                  "$ref": "#/$defs/Length"
                }
              },
              "required": [
                "stated",
                "derived"
              ],
              "type": "object"
            }
          },
          "required": [
            "pitch_disagrees"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The ledger face could not be solved.",
          "properties": {
            "solve": {
              "$ref": "#/$defs/SolveError"
            }
          },
          "required": [
            "solve"
          ],
          "type": "object"
        },
        {
          "const": "no_low_height",
          "description": "Neither a low edge height nor a pitch is given.",
          "type": "string"
        }
      ]
    },
    "SolveError": {
      "description": "Why the document cannot be solved at all.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "An entity named by a wall or constraint does not exist.",
          "properties": {
            "unknown_entity": {
              "properties": {
                "id": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          },
          "required": [
            "unknown_entity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A reference has no coordinate on the constraint's axis.",
          "properties": {
            "wrong_axis": {
              "properties": {
                "constraint": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "constraint"
              ],
              "type": "object"
            }
          },
          "required": [
            "wrong_axis"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A WallFace boundary index beyond the wall's layers.",
          "properties": {
            "no_such_boundary": {
              "properties": {
                "constraint": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "constraint"
              ],
              "type": "object"
            }
          },
          "required": [
            "no_such_boundary"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An Equal names something that is not a Distance constraint.",
          "properties": {
            "not_a_distance": {
              "properties": {
                "constraint": {
                  "$ref": "#/$defs/Uuid"
                },
                "target": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "constraint",
                "target"
              ],
              "type": "object"
            }
          },
          "required": [
            "not_a_distance"
          ],
          "type": "object"
        },
        {
          "const": "overflow",
          "description": "A solved coordinate is outside the Length range.",
          "type": "string"
        }
      ]
    },
    "SpaceError": {
      "description": "Why a space, slab or ceiling outline cannot be found.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "geometry": {
              "$ref": "#/$defs/GeometryError"
            }
          },
          "required": [
            "geometry"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "polygon": {
              "$ref": "#/$defs/PolygonError"
            }
          },
          "required": [
            "polygon"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "unknown_entity": {
              "properties": {
                "id": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          },
          "required": [
            "unknown_entity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The seed lies inside a wall.",
          "properties": {
            "seed_in_wall": {
              "properties": {
                "space": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "space"
              ],
              "type": "object"
            }
          },
          "required": [
            "seed_in_wall"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The walls do not enclose the seed.",
          "properties": {
            "open": {
              "properties": {
                "space": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "space"
              ],
              "type": "object"
            }
          },
          "required": [
            "open"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Walls stand free inside the room (Q-25).",
          "properties": {
            "island": {
              "properties": {
                "space": {
                  "$ref": "#/$defs/Uuid"
                },
                "walls": {
                  "items": {
                    "$ref": "#/$defs/Uuid"
                  },
                  "type": "array"
                }
              },
              "required": [
                "space",
                "walls"
              ],
              "type": "object"
            }
          },
          "required": [
            "island"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The region touches itself at a corner, so it is not one simple polygon.",
          "properties": {
            "not_simple": {
              "properties": {
                "space": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "space"
              ],
              "type": "object"
            }
          },
          "required": [
            "not_simple"
          ],
          "type": "object"
        },
        {
          "const": "no_spaces",
          "description": "A boundary from spaces lists none (DEC-5).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A boundary from spaces lists spaces on different storeys (DEC-5).",
          "properties": {
            "storey_mismatch": {
              "properties": {
                "space": {
                  "$ref": "#/$defs/Uuid"
                }
              },
              "required": [
                "space"
              ],
              "type": "object"
            }
          },
          "required": [
            "storey_mismatch"
          ],
          "type": "object"
        }
      ]
    },
    "Uuid": {
      "description": "An entity identifier. Serialized as a lowercase hyphenated string.",
      "format": "uuid",
      "type": "string"
    },
    "ValidateResult": {
      "properties": {
        "blocks_commit": {
          "type": "boolean"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/Violation"
          },
          "type": "array"
        }
      },
      "required": [
        "violations",
        "blocks_commit"
      ],
      "type": "object"
    },
    "Violation": {
      "description": "One failed invariant.",
      "properties": {
        "acknowledged": {
          "description": "Marked Acknowledged by the user: reported but not blocking.",
          "type": "boolean"
        },
        "detail": {
          "$ref": "#/$defs/Detail"
        },
        "key": {
          "$ref": "#/$defs/ViolationKey"
        }
      },
      "required": [
        "key",
        "detail",
        "acknowledged"
      ],
      "type": "object"
    },
    "ViolationKey": {
      "additionalProperties": false,
      "description": "Identifies a violation across solves: its kind and the sorted ids of the\nentities involved (Q-28).",
      "properties": {
        "entities": {
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ViolationKind"
        }
      },
      "required": [
        "kind",
        "entities"
      ],
      "type": "object"
    },
    "ViolationKind": {
      "description": "What a validity violation is about (7.7).",
      "oneOf": [
        {
          "const": "wall_length",
          "description": "A wall without positive length along its direction.",
          "type": "string"
        },
        {
          "const": "wall_overlap",
          "description": "Two walls overlap without a declared join.",
          "type": "string"
        },
        {
          "const": "opening_outside_host",
          "description": "An opening is not fully inside its host.",
          "type": "string"
        },
        {
          "const": "space_outline",
          "description": "A Space boundary is not a simple rectilinear polygon.",
          "type": "string"
        },
        {
          "const": "slab_outline",
          "description": "A Slab boundary is not a simple rectilinear polygon.",
          "type": "string"
        },
        {
          "const": "roof_definition",
          "description": "A roof's ledger, footprint, run or heights do not define a roof (Q-44, Q-45).",
          "type": "string"
        },
        {
          "const": "clearance_zone",
          "description": "A clearance zone is blocked by a wall or another occurrence (Q-32).",
          "type": "string"
        },
        {
          "const": "min_clearance",
          "description": "A MinClearance constraint is not met after solving (7.1, Q-32).",
          "type": "string"
        },
        {
          "const": "occurrence_overlap",
          "description": "An occurrence overlaps a wall or another occurrence (Q-27, Q-32).",
          "type": "string"
        },
        {
          "const": "wall_top",
          "description": "A wall that follows a roof names no roof, or lies outside the roof's\nfootprint plus overhangs (DEC-6).",
          "type": "string"
        }
      ]
    },
    "WallTopProblem": {
      "description": "What is wrong with a wall that follows a roof (DEC-6).",
      "oneOf": [
        {
          "const": "unknown_roof",
          "description": "The roof it names does not exist.",
          "type": "string"
        },
        {
          "const": "outside_roof",
          "description": "Its footprint is not inside the roof's footprint plus overhangs.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The response every subcommand writes.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/CliError"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidateResult"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "ok"
  ],
  "title": "Response",
  "type": "object"
}
