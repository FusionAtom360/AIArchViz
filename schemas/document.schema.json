{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "An external file (IfcDocumentReference).",
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "converter_log": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        },
        "license": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content_hash",
        "license",
        "fidelity",
        "converter_log"
      ],
      "type": "object"
    },
    "Authority": {
      "description": "Dimension authority, highest first (D-11).",
      "enum": [
        "user_stated_exact",
        "manufacturer_spec",
        "cad_derived",
        "measured_with_tolerance",
        "proposed_default",
        "mesh_derived"
      ],
      "type": "string"
    },
    "Axis": {
      "description": "A plan axis.",
      "enum": [
        "x",
        "y"
      ],
      "type": "string"
    },
    "Boundary": {
      "description": "A rectilinear boundary given explicitly or taken from a space.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "explicit",
              "type": "string"
            },
            "points": {
              "items": {
                "$ref": "#/$defs/Point"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "points"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "from_space",
              "type": "string"
            },
            "space": {
              "$ref": "#/$defs/Uuid"
            }
          },
          "required": [
            "kind",
            "space"
          ],
          "type": "object"
        }
      ]
    },
    "Building": {
      "additionalProperties": false,
      "description": "The building (IfcBuilding).",
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "CalibrationCheck": {
      "additionalProperties": false,
      "description": "A second known distance and how far the calibration misses it. The\nresidual is derived and stored (Q-7).",
      "properties": {
        "known": {
          "$ref": "#/$defs/KnownDistance"
        },
        "residual": {
          "$ref": "#/$defs/Length"
        }
      },
      "required": [
        "known",
        "residual"
      ],
      "type": "object"
    },
    "CameraBookmark": {
      "additionalProperties": false,
      "description": "A named viewpoint (12.6).",
      "properties": {
        "eye_height": {
          "$ref": "#/$defs/Sourced"
        },
        "heading": {
          "$ref": "#/$defs/Millidegrees"
        },
        "name": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Point"
        },
        "storey": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "name",
        "storey",
        "position",
        "eye_height",
        "heading"
      ],
      "type": "object"
    },
    "Ceiling": {
      "additionalProperties": false,
      "description": "A ceiling (IfcCovering).",
      "properties": {
        "boundary": {
          "$ref": "#/$defs/Boundary"
        },
        "elevation": {
          "$ref": "#/$defs/Sourced"
        },
        "storey": {
          "$ref": "#/$defs/Uuid"
        },
        "thickness": {
          "$ref": "#/$defs/Sourced"
        }
      },
      "required": [
        "storey",
        "boundary",
        "thickness",
        "elevation"
      ],
      "type": "object"
    },
    "Clearance": {
      "additionalProperties": false,
      "description": "Clearance zone extents around a footprint (Q-8).",
      "properties": {
        "back": {
          "$ref": "#/$defs/Sourced"
        },
        "front": {
          "$ref": "#/$defs/Sourced"
        },
        "left": {
          "$ref": "#/$defs/Sourced"
        },
        "right": {
          "$ref": "#/$defs/Sourced"
        }
      },
      "required": [
        "front",
        "back",
        "left",
        "right"
      ],
      "type": "object"
    },
    "Constraint": {
      "additionalProperties": false,
      "description": "A constraint (IfcConstraint, weak).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConstraintKind"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "status": {
          "$ref": "#/$defs/ConstraintStatus"
        }
      },
      "required": [
        "kind",
        "status",
        "source"
      ],
      "type": "object"
    },
    "ConstraintKind": {
      "description": "Constraint kinds (7.1).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "coordinate(b) - coordinate(a) = value along `axis` (signed, Q-13).",
          "properties": {
            "a": {
              "$ref": "#/$defs/Reference"
            },
            "axis": {
              "$ref": "#/$defs/Axis"
            },
            "b": {
              "$ref": "#/$defs/Reference"
            },
            "kind": {
              "const": "distance",
              "type": "string"
            },
            "tolerance": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Length"
                },
                {
                  "type": "null"
                }
              ]
            },
            "value": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "kind",
            "a",
            "b",
            "axis",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "a": {
              "$ref": "#/$defs/Reference"
            },
            "axis": {
              "$ref": "#/$defs/Axis"
            },
            "b": {
              "$ref": "#/$defs/Reference"
            },
            "kind": {
              "const": "align",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "a",
            "b",
            "axis"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Two Distance constraints, by id, have equal values.",
          "properties": {
            "first": {
              "$ref": "#/$defs/Uuid"
            },
            "kind": {
              "const": "equal",
              "type": "string"
            },
            "second": {
              "$ref": "#/$defs/Uuid"
            }
          },
          "required": [
            "kind",
            "first",
            "second"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The reference's coordinate on `axis` equals `value` (Q-13).",
          "properties": {
            "axis": {
              "$ref": "#/$defs/Axis"
            },
            "kind": {
              "const": "fixed",
              "type": "string"
            },
            "reference": {
              "$ref": "#/$defs/Reference"
            },
            "value": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "kind",
            "reference",
            "axis",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Checked after solving, not solved (7.1).",
          "properties": {
            "kind": {
              "const": "min_clearance",
              "type": "string"
            },
            "object": {
              "$ref": "#/$defs/Uuid"
            },
            "other": {
              "$ref": "#/$defs/Uuid"
            },
            "value": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "kind",
            "object",
            "other",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ConstraintStatus": {
      "description": "Driving or Reference (7.2).",
      "enum": [
        "driving",
        "reference"
      ],
      "type": "string"
    },
    "ContentHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Datum": {
      "additionalProperties": false,
      "description": "A named point or line anchoring an axis (IfcGrid).",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/DatumGeometry"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "geometry"
      ],
      "type": "object"
    },
    "DatumGeometry": {
      "description": "The shape of a datum.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A point; anchors both axes.",
          "properties": {
            "kind": {
              "const": "point",
              "type": "string"
            },
            "x": {
              "$ref": "#/$defs/Length"
            },
            "y": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "kind",
            "x",
            "y"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The line x = constant; anchors the X axis.",
          "properties": {
            "kind": {
              "const": "x_line",
              "type": "string"
            },
            "x": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "kind",
            "x"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The line y = constant; anchors the Y axis.",
          "properties": {
            "kind": {
              "const": "y_line",
              "type": "string"
            },
            "y": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "kind",
            "y"
          ],
          "type": "object"
        }
      ]
    },
    "DeclaredDimensions": {
      "additionalProperties": false,
      "description": "Declared footprint and height of an element type (10.2).",
      "properties": {
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "depth": {
          "$ref": "#/$defs/Length"
        },
        "height": {
          "$ref": "#/$defs/Length"
        },
        "width": {
          "$ref": "#/$defs/Length"
        }
      },
      "required": [
        "width",
        "depth",
        "height",
        "authority"
      ],
      "type": "object"
    },
    "Direction": {
      "description": "A compass direction along a plan axis.",
      "enum": [
        "pos_x",
        "neg_x",
        "pos_y",
        "neg_y"
      ],
      "type": "string"
    },
    "ElementType": {
      "additionalProperties": false,
      "description": "A type of placed object (IfcTypeObject).",
      "properties": {
        "declared_dimensions": {
          "$ref": "#/$defs/DeclaredDimensions"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        },
        "license": {
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "properties": {
          "additionalProperties": {
            "$ref": "#/$defs/PropertyValue"
          },
          "type": "object"
        },
        "source": {
          "description": "Where the dimensions came from, e.g. a manufacturer URL.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "declared_dimensions",
        "fidelity",
        "properties",
        "source",
        "license"
      ],
      "type": "object"
    },
    "Feature": {
      "additionalProperties": false,
      "description": "An operator instance and the children it derived (8.5).",
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "type": "array"
        },
        "operator": {
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/PropertyValue"
          },
          "type": "object"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "type": "array"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "operator",
        "version",
        "parameters",
        "targets",
        "children"
      ],
      "type": "object"
    },
    "Fidelity": {
      "description": "Asset fidelity tiers (10.1).",
      "enum": [
        "exact",
        "library",
        "generated",
        "proxy"
      ],
      "type": "string"
    },
    "Finishes": {
      "additionalProperties": false,
      "description": "Finish materials of a space.",
      "properties": {
        "ceiling": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "floor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "walls": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Function": {
      "description": "Whether an element exists, is new work, or is to be removed (6.7).",
      "enum": [
        "existing",
        "new",
        "demolished"
      ],
      "type": "string"
    },
    "ItemSide": {
      "description": "A side of an occurrence footprint, in the occurrence's own frame.",
      "enum": [
        "front",
        "back",
        "left",
        "right"
      ],
      "type": "string"
    },
    "JoinType": {
      "description": "How walls meet at a node (6.1). Derived.",
      "oneOf": [
        {
          "const": "isolated",
          "description": "No wall ends here.",
          "type": "string"
        },
        {
          "const": "free_end",
          "description": "One wall ends here, square.",
          "type": "string"
        },
        {
          "const": "straight",
          "description": "Two collinear walls meet end to end, square (Q-19).",
          "type": "string"
        },
        {
          "const": "l",
          "description": "Two walls, mitered.",
          "type": "string"
        },
        {
          "const": "t",
          "description": "Three walls; the lowest join_priority runs through.",
          "type": "string"
        },
        {
          "const": "x",
          "description": "Four walls; the lowest join_priority runs through.",
          "type": "string"
        }
      ]
    },
    "KnownDistance": {
      "additionalProperties": false,
      "description": "Two image points and the real distance between them.",
      "properties": {
        "distance": {
          "$ref": "#/$defs/Sourced"
        },
        "pixel_a": {
          "$ref": "#/$defs/PixelPoint"
        },
        "pixel_b": {
          "$ref": "#/$defs/PixelPoint"
        }
      },
      "required": [
        "pixel_a",
        "pixel_b",
        "distance"
      ],
      "type": "object"
    },
    "Label": {
      "pattern": "^[A-Z]+-(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,})$",
      "type": "string"
    },
    "LabelAllocator": {
      "additionalProperties": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "description": "Issues labels per prefix. Numbers only ever increase, so a label is never\nreissued, even after the entity that held it is deleted. Serialized as\nthe map from prefix to the last number issued, so the guarantee survives\nsaving and loading.",
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "description": "One material layer.",
      "properties": {
        "core": {
          "type": "boolean"
        },
        "material": {
          "$ref": "#/$defs/Uuid"
        },
        "thickness": {
          "$ref": "#/$defs/Sourced"
        }
      },
      "required": [
        "material",
        "thickness",
        "core"
      ],
      "type": "object"
    },
    "LayerSet": {
      "additionalProperties": false,
      "description": "Layers ordered left to right (IfcMaterialLayerSet).",
      "properties": {
        "layers": {
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "layers"
      ],
      "type": "object"
    },
    "Length": {
      "description": "A length in nanometers. Serialized as a bare JSON integer.",
      "format": "int64",
      "type": "integer"
    },
    "Light": {
      "additionalProperties": false,
      "description": "Light data of a light-fixture occurrence (Q-6, 11.3, 12.4).",
      "properties": {
        "ies": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "kelvin": {
          "$ref": "#/$defs/Sourced2"
        },
        "kind": {
          "$ref": "#/$defs/LightKind"
        },
        "lumens": {
          "$ref": "#/$defs/Sourced2"
        }
      },
      "required": [
        "kind",
        "lumens",
        "kelvin"
      ],
      "type": "object"
    },
    "LightKind": {
      "description": "Light emitter kinds (11.3).",
      "enum": [
        "point",
        "spot",
        "rect"
      ],
      "type": "string"
    },
    "Material": {
      "additionalProperties": false,
      "description": "A material (Q-6).",
      "properties": {
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "properties": {
          "additionalProperties": {
            "$ref": "#/$defs/PropertyValue"
          },
          "type": "object"
        },
        "tile_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ],
          "description": "Real-world size of one texture tile (12.4)."
        }
      },
      "required": [
        "name",
        "properties"
      ],
      "type": "object"
    },
    "Millidegrees": {
      "maximum": 359999,
      "minimum": 0,
      "type": "integer"
    },
    "Node": {
      "additionalProperties": false,
      "description": "A polyline vertex. Position and join type are solved and stored (Q-7).",
      "properties": {
        "join": {
          "$ref": "#/$defs/JoinType"
        },
        "x": {
          "$ref": "#/$defs/Length"
        },
        "y": {
          "$ref": "#/$defs/Length"
        }
      },
      "required": [
        "x",
        "y",
        "join"
      ],
      "type": "object"
    },
    "Occurrence": {
      "additionalProperties": false,
      "description": "A placed object (IfcFurniture, IfcBuildingElementProxy, IfcLightFixture).",
      "properties": {
        "center": {
          "$ref": "#/$defs/Point",
          "description": "Solved footprint center in plan. Derived and stored (Q-7, Q-31)."
        },
        "clearance": {
          "$ref": "#/$defs/Clearance"
        },
        "element_type": {
          "$ref": "#/$defs/Uuid"
        },
        "fixed": {
          "description": "Never moves as a consequence of another edit (6.3).",
          "type": "boolean"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "light": {
          "anyOf": [
            {
              "$ref": "#/$defs/Light"
            },
            {
              "type": "null"
            }
          ]
        },
        "overlap_allowed": {
          "description": "May overlap walls and other occurrences without a violation (7.7, Q-32).",
          "type": "boolean"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "storey": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "label",
        "storey",
        "element_type",
        "placement",
        "clearance",
        "fixed",
        "overlap_allowed",
        "center"
      ],
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "description": "An opening, door or window in a host wall (IfcOpeningElement, IfcDoor, IfcWindow).",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/OpeningEdge",
          "description": "Which edge of the opening sits `offset` from `reference`."
        },
        "height": {
          "$ref": "#/$defs/Sourced"
        },
        "host": {
          "$ref": "#/$defs/Uuid"
        },
        "kind": {
          "$ref": "#/$defs/OpeningKind"
        },
        "offset": {
          "$ref": "#/$defs/Sourced",
          "description": "From the reference to the anchor edge, positive toward the host's\nnode_b (Q-20)."
        },
        "reference": {
          "$ref": "#/$defs/Reference",
          "description": "The along-wall reference the opening is positioned from."
        },
        "sill": {
          "$ref": "#/$defs/Sourced"
        },
        "start": {
          "$ref": "#/$defs/Length",
          "description": "Solved coordinate of the start edge (the one nearer the host's\nnode_a) on the host's along axis. Derived and stored (Q-7, Q-20)."
        },
        "width": {
          "$ref": "#/$defs/Sourced"
        }
      },
      "required": [
        "kind",
        "host",
        "reference",
        "anchor",
        "offset",
        "start",
        "width",
        "height",
        "sill"
      ],
      "type": "object"
    },
    "OpeningEdge": {
      "description": "An edge or the center of an opening along its host wall.",
      "enum": [
        "start",
        "end",
        "center"
      ],
      "type": "string"
    },
    "OpeningKind": {
      "description": "What fills an opening.",
      "enum": [
        "opening",
        "door",
        "window"
      ],
      "type": "string"
    },
    "Overhang": {
      "additionalProperties": false,
      "description": "Eave overhang per compass side, applied to every footprint edge facing\nthat way (Q-8).",
      "properties": {
        "neg_x": {
          "$ref": "#/$defs/Sourced"
        },
        "neg_y": {
          "$ref": "#/$defs/Sourced"
        },
        "pos_x": {
          "$ref": "#/$defs/Sourced"
        },
        "pos_y": {
          "$ref": "#/$defs/Sourced"
        }
      },
      "required": [
        "pos_x",
        "neg_x",
